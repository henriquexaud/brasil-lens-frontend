# ---------------------------------------------------------------------------
# Brasil Lens — frontend. Configuração opcional: tudo tem default.
#
# ATENÇÃO: o Vite resolve VITE_* em tempo de *build*, não em runtime. Mudar
# estes valores exige reconstruir (`docker compose up --build` ou
# `npm run build`) — editar o .env com o bundle pronto não tem efeito.
# ---------------------------------------------------------------------------

# URL base da API. É a URL que o *navegador* usa: por isso "localhost" mesmo
# quando a API roda em container.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Porta em que o docker-compose publica o frontend.
WEB_PORT=5173
